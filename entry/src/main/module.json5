{
  "module": {
    "name": "adminprovisioning",
    "type": "entry",
    "description": "$string:description_adminProvisioning",
    "mainElement": "com.ohos.adminprovisioning.MainAbility",
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ],
        "removeMissionAfterTerminate": true,
        "name": "com.ohos.adminprovisioning.MainAbility",
        "description": "$string:description_mainability",
        "icon": "$media:icon",
        "label": "$string:entry_MainAbility",
        "visible": false,
        "launchType": "singleton",
        "startWindowIcon": "$media:transparent",
        "startWindowBackground": "$color:color_00000000_transparent",
        "srcEntry": "./ets/MainAbility/MainAbility.ts"
      },
      {
        "removeMissionAfterTerminate": true,
        "name": "com.ohos.automanager.AutoManagerAbility",
        "description": "$string:description_autoManagerAbility",
        "icon": "$media:icon",
        "visible": true,
        "launchType": "singleton",
        "permissions": [
          "ohos.permission.PROVISIONING_MESSAGE"
        ],
        "startWindowIcon": "$media:transparent",
        "startWindowBackground": "$color:color_00000000_transparent",
        "srcEntry": "./ets/MainAbility/AutoManagerAbility.ts"
      },
      {
        "removeMissionAfterTerminate": true,
        "name": "ByodAdminProvisionAbility",
        "description": "$string:description_ByodAdminProvisionAbility",
        "icon": "$media:icon",
        "exported": true,
        "launchType": "singleton",
        "permissions": [
          "ohos.permission.START_PROVISIONING_MESSAGE"
        ],
        "startWindowIcon": "$media:transparent",
        "startWindowBackground": "$color:color_00000000_transparent",
        "srcEntry": "./ets/MainAbility/ByodAdminProvisionAbility.ts"
      }
    ],
    "extensionAbilities": [
      {
        "name": "MDMUIExtensionAbility",
        "icon": "$media:icon",
        "description": "UIExtensionAbility",
        "exported": false,
        "type": "sys/commonUI",
        "srcEntry": "./ets/MainAbility/UIExtensionAbility.ets"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.MANAGE_LOCAL_ACCOUNTS"
      },
      {
        "name": "ohos.permission.GET_BUNDLE_INFO"
      },
      {
        "name": "ohos.permission.MANAGE_ENTERPRISE_DEVICE_ADMIN"
      },
      {
        "name": "ohos.permission.FACTORY_RESET"
      },
      {
        "name": "ohos.permission.INTERNET"
      }
    ],
    "srcEntry": "./ets/Application/AbilityStage.ts"
  }
}
